{
  "expo": {
    "name": "FinBudgetAI",
    "slug": "finbudgetai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finbudgetai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finbudgetai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.466323878357-l7a3rcma7e4dfeesk86fo0vghojetpd5"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.finbudgetai.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.466323878357-l7a3rcma7e4dfeesk86fo0vghojetpd5"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FinBudgetAI to use Face ID for authentication"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aba94def-8be2-4272-a03c-0a0efa1e88ed"
      },
      "apiBaseUrl": "https://finai-backend-466323878357.us-east1.run.app/api",
      "revenueCatIosKey": "appl_whKeNwVIVYUqoYGXvSxYGGJVCeI",
      "revenueCatAndroidKey": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aba94def-8be2-4272-a03c-0a0efa1e88ed",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
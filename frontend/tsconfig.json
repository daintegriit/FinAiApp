{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "moduleResolution": "bundler",

    "allowJs": true,

    "resolveJsonModule": true,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "types": ["react", "react-native"]
  },

  "include": [
    "src",
    "app",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],

  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}
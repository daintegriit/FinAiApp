name: Global Validation Suite

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:

  validation:
    runs-on: ubuntu-latest

    steps:

    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Setup Python
      uses: actions/setup-python@v5
      with:
        python-version: "3.11"

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r backend/requirements.txt

    - name: Verify engine module imports
      run: |
        cd backend
        python -c "import pkgutil, importlib, app.engines; [importlib.import_module(f'app.engines.{m.name}') for m in pkgutil.iter_modules(app.engines.__path__)]; print('All engine modules imported successfully.')"

    - name: Run Financial Engine Validation
      run: |
        cd backend
        python -m scripts.run_global_validation